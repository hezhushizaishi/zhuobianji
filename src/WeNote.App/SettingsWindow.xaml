<ui:FluentWindow x:Class="WeNote.App.SettingsWindow" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="桌边记设置" Width="480" Height="620" MinWidth="440" MinHeight="540"
 ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" FontFamily="Microsoft YaHei UI">
 <ui:FluentWindow.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries>
   <ui:ThemesDictionary Theme="Light" />
   <ui:ControlsDictionary />
  </ResourceDictionary.MergedDictionaries></ResourceDictionary>
 </ui:FluentWindow.Resources>
 <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <ui:TitleBar Title="桌边记设置" ShowMaximize="False" ShowMinimize="False" />
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="24,12,24,20">
    <TabControl x:Name="SettingsTabs">
     <TabItem Header="外观">
      <StackPanel Margin="0,16,0,0">
       <ui:Card Padding="16">
        <StackPanel x:Name="AppearancePanel">
         <ui:TextBlock x:Name="NoteLabel" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,14" />
         <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <ui:TextBlock Text="配色" VerticalAlignment="Center" />
          <ComboBox x:Name="PaletteBox" Grid.Column="1" SelectionChanged="OnAppearanceChanged" />
         </Grid>
         <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <ui:TextBlock Text="深色" VerticalAlignment="Center" />
          <ui:ToggleSwitch x:Name="DarkSwitch" Grid.Column="1" OnContent="开" OffContent="关" Checked="OnAppearanceChanged" Unchecked="OnAppearanceChanged" />
         </Grid>
         <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <ui:TextBlock Text="字体" VerticalAlignment="Center" />
          <ComboBox x:Name="FontBox" Grid.Column="1" SelectionChanged="OnAppearanceChanged" />
         </Grid>
         <Grid><ui:TextBlock Text="字号" /><ui:TextBlock x:Name="FontSizeLabel" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></Grid>
         <Slider x:Name="SizeSlider" Minimum="12" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnAppearanceChanged" Margin="0,8,0,16" />
         <Grid><ui:TextBlock Text="透明度" /><ui:TextBlock x:Name="OpacityLabel" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></Grid>
         <Slider x:Name="OpacitySlider" ToolTip="0% 全透明，100% 不透明；可从托盘设置恢复。" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnAppearanceChanged" Margin="0,8,0,4" />
         <ui:Button x:Name="DefaultsButton" Content="设为默认" Appearance="Secondary" HorizontalAlignment="Stretch" Click="OnSaveDefaults" />
        </StackPanel>
       </ui:Card>
      </StackPanel>
     </TabItem>
     <TabItem Header="程序">
      <StackPanel Margin="0,16,0,0">
       <ui:TextBlock Text="程序设置" FontTypography="BodyStrong" Margin="0,0,0,8" />
       <ui:Card Padding="16">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,16,0">
          <ui:TextBlock Text="开机自启" />
         </StackPanel>
         <ui:ToggleSwitch x:Name="StartupSwitch" Grid.Column="1" VerticalAlignment="Center" OnContent="开" OffContent="关" Checked="OnStartupChanged" Unchecked="OnStartupChanged" />
        </Grid>
       </ui:Card>
       <ui:Card Padding="16" Margin="0,12,0,0">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <ui:TextBlock Text="格式切换提示" VerticalAlignment="Center" />
         <ui:ToggleSwitch x:Name="FormatWarningsSwitch" Grid.Column="1" VerticalAlignment="Center" OnContent="开" OffContent="关" Checked="OnFormatWarningsChanged" Unchecked="OnFormatWarningsChanged" />
        </Grid>
       </ui:Card>
       <ui:TextBlock Text="数据位置" FontTypography="BodyStrong" Margin="0,20,0,8" />
       <ui:Card Padding="16">
        <StackPanel>
         <TextBox x:Name="DataPath" IsReadOnly="True" TextWrapping="Wrap" Margin="0,0,0,12" />
         <ui:Button Content="打开数据文件夹" Appearance="Secondary" HorizontalAlignment="Stretch" Click="OnOpenData" />
        </StackPanel>
       </ui:Card>
      </StackPanel>
     </TabItem>
     <TabItem Header="快捷键">
      <StackPanel Margin="0,16,0,0">
       <ui:Card Padding="16">
        <StackPanel>
         <ui:TextBlock Text="新建便签" Margin="0,0,0,8" />
         <Grid Margin="0,0,0,20">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBox x:Name="NewNoteHotkey" IsReadOnly="True" PreviewKeyDown="OnHotkeyKeyDown" GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur" ToolTip="点击后按 Ctrl 或 Alt 加一个按键；Backspace 清空。" MinHeight="34" VerticalContentAlignment="Center" />
          <ui:Button Grid.Column="1" Content="清空" Tag="NewNoteHotkey" Appearance="Secondary" Margin="8,0,0,0" Click="OnClearHotkey" />
         </Grid>
         <ui:TextBlock Text="显示／隐藏全部" Margin="0,0,0,8" />
         <Grid Margin="0,0,0,20">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBox x:Name="ToggleNotesHotkey" IsReadOnly="True" PreviewKeyDown="OnHotkeyKeyDown" GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur" ToolTip="点击后按 Ctrl 或 Alt 加一个按键；Backspace 清空。" MinHeight="34" VerticalContentAlignment="Center" />
          <ui:Button Grid.Column="1" Content="清空" Tag="ToggleNotesHotkey" Appearance="Secondary" Margin="8,0,0,0" Click="OnClearHotkey" />
         </Grid>
         <ui:Button x:Name="ApplyHotkeysButton" Content="保存快捷键" Appearance="Secondary" HorizontalAlignment="Stretch" Click="OnSaveHotkeys" />
        </StackPanel>
       </ui:Card>
      </StackPanel>
     </TabItem>
    </TabControl>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="2" Margin="24,8,24,20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <ui:TextBlock x:Name="Status" Text="" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
   <ui:Button x:Name="DoneButton" Grid.Column="1" Content="完成" Appearance="Secondary" MinWidth="80" Click="OnDone" />
  </Grid>
 </Grid>
</ui:FluentWindow>