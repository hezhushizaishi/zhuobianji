<Window x:Class="Zhuobianji.NoteWindow" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Zhuobianji"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="桌边记" Width="420" Height="440" MinWidth="320" MinHeight="260"
 WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize" ShowInTaskbar="False"
 Background="Transparent" Foreground="{DynamicResource Text}" FontFamily="Microsoft YaHei UI">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False" />
 </shell:WindowChrome.WindowChrome>
 <!-- 颜色资源由 NoteTheme.ApplyTo 在构造时写入；控件样式见 Theme/NoteStyles.xaml。 -->
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Zhuobianji;component/Theme/NoteStyles.xaml" />
   </ResourceDictionary.MergedDictionaries>
   <!-- 收纳标签的右键菜单：每个标签一份，DataContext 是对应的子便签窗口。 -->
   <ContextMenu x:Key="CollectionTabMenu" x:Shared="False">
    <MenuItem Header="展开" Click="OnTabExpand" />
    <MenuItem Header="收起" Click="OnTabCollapse" />
    <MenuItem Header="取出" Click="OnTabTakeOut" />
    <Separator />
    <MenuItem Header="删除这张" Click="OnTabDelete">
     <MenuItem.Icon><ui:SymbolIcon Style="{StaticResource DeleteIcon}" Foreground="{DynamicResource Muted}" /></MenuItem.Icon>
    </MenuItem>
   </ContextMenu>
  </ResourceDictionary>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="0" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <!-- 左侧标签区：只有主便签有宽度；关闭标签时保留透明区域，窗口边界不变。 -->
  <Grid x:Name="RailViewport" Grid.Column="0" Margin="0,48,8,6" ClipToBounds="True">
   <Grid x:Name="CollectionRail" Visibility="Collapsed">
    <Grid.RenderTransform><TranslateTransform x:Name="RailTranslation" /></Grid.RenderTransform>
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer x:Name="CollectionScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" AllowDrop="True" DragOver="OnCollectionDragOver" DragLeave="OnCollectionDragLeave" Drop="OnCollectionDrop">
     <StackPanel x:Name="CollectionTabs" Background="Transparent" />
    </ScrollViewer>
    <Border x:Name="CollectionDropMarker" Height="2" Background="{DynamicResource Muted}" CornerRadius="1" Margin="2,0,2,0" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed" />
    <Button x:Name="CollectionNewButton" Grid.Row="1" Style="{StaticResource RailButton}" Content="＋ 新建" ToolTip="新建收纳便签" Click="OnNewCollected" Margin="0,6,0,0" />
   </Grid>
  </Grid>
  <Border x:Name="NoteCard" Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="10">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="42" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" MinHeight="32" />
    </Grid.RowDefinitions>
    <Border x:Name="HeaderBand" Background="{DynamicResource Header}" BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,0,1" CornerRadius="9,9,0,0">
     <DockPanel Margin="16,0,8,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
       <ToggleButton x:Name="CollectionRailToggle" Style="{StaticResource RailToggle}" Content="标签" FontSize="11" Click="OnToggleRail" Visibility="Collapsed" />
       <Button Style="{StaticResource ToolButton}" Content="＋" FontSize="20" Width="32" ToolTip="新建便签（Ctrl+N）" AutomationProperties.Name="新建便签" Click="OnNewNote" />
       <ToggleButton x:Name="PinButton" Style="{StaticResource ToolToggle}" Content="置顶" FontSize="11" Width="52" Click="OnTogglePinned" />
       <Button x:Name="MoreButton" Style="{StaticResource ToolButton}" Content="⋯" FontSize="20" Width="30" ToolTip="更多操作" Click="OnMore">
        <Button.ContextMenu><ContextMenu>
         <MenuItem Header="新建富文本便签" Click="OnNewRich" />
         <MenuItem Header="新建 Markdown 便签" Click="OnNewMarkdown" />
         <MenuItem Header="新建纯文本便签" Click="OnNewPlain" />
         <Separator />
         <MenuItem Header="设置…" Click="OnAppearance" />
         <MenuItem x:Name="SetMainItem" Header="设为主便签" Click="OnSetMain" />
         <MenuItem x:Name="CollectItem" Header="收纳到主便签" Click="OnCollect" Visibility="Collapsed" />
         <MenuItem x:Name="DesktopMenuItem" Header="贴到桌面" Click="OnDesktop" />
         <MenuItem x:Name="FloatingMenuItem" Header="恢复普通浮窗" Click="OnFloating" />
         <Separator />
         <MenuItem Header="显示所有便签" Click="OnShowAll" />
         <MenuItem Header="关闭这张便签" InputGestureText="Ctrl+W" Click="OnHide" />
         <MenuItem Header="删除这张便签" Click="OnDelete">
          <MenuItem.Icon><ui:SymbolIcon Style="{StaticResource DeleteIcon}" Foreground="{DynamicResource Muted}" /></MenuItem.Icon>
         </MenuItem>
         <Separator />
         <MenuItem Header="退出程序" InputGestureText="Ctrl+Shift+Q" Click="OnExit" />
        </ContextMenu></Button.ContextMenu>
       </Button>
       <Button x:Name="CloseButton" Style="{StaticResource ToolButton}" Content="×" FontSize="20" Width="30" ToolTip="关闭便签（Ctrl+W）" AutomationProperties.Name="关闭便签" Click="OnHide" />
      </StackPanel>
      <TextBlock x:Name="HeaderLabel" Text="桌边记" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
     </DockPanel>
    </Border>
    <local:NoteEditor x:Name="OwnEditor" Grid.Row="1" Margin="22,10,18,10" />
    <Border x:Name="FormatBar" Grid.Row="2" Margin="16,0,16,3" BorderBrush="{DynamicResource Edge}" BorderThickness="0,1,0,0" Padding="0,5,0,0" Visibility="Collapsed">
     <WrapPanel>
      <Button Style="{StaticResource ToolButton}" FontWeight="Bold" Content="B" ToolTip="粗体（Ctrl+B）" Focusable="False" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=OwnEditor, Path=RichEditor}" />
      <Button Style="{StaticResource ToolButton}" FontStyle="Italic" Content="I" ToolTip="斜体（Ctrl+I）" Focusable="False" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=OwnEditor, Path=RichEditor}" />
      <Button Style="{StaticResource ToolButton}" ToolTip="下划线（Ctrl+U）" Focusable="False" Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=OwnEditor, Path=RichEditor}"><TextBlock Text="U" TextDecorations="Underline" /></Button>
      <Button Style="{StaticResource ToolButton}" ToolTip="删除线" Focusable="False" Click="OnStrike"><TextBlock Text="S" TextDecorations="Strikethrough" /></Button>
      <Button Style="{StaticResource ToolButton}" Content="• 列表" ToolTip="项目符号" Focusable="False" Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=OwnEditor, Path=RichEditor}" />
      <Button Style="{StaticResource ToolButton}" Content="1. 列表" ToolTip="编号列表" Focusable="False" Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=OwnEditor, Path=RichEditor}" />
      <Button x:Name="ColorButton" Style="{StaticResource ToolButton}" Content="A ▾" ToolTip="文字颜色" Focusable="False" Click="OnTextColor" />
     </WrapPanel>
    </Border>
    <DockPanel Grid.Row="3" Margin="12,0,6,3">
     <ResizeGrip DockPanel.Dock="Right" Width="16" Height="16" VerticalAlignment="Bottom" shell:WindowChrome.ResizeGripDirection="BottomRight" />
     <Button x:Name="DeleteButton" DockPanel.Dock="Right" Style="{StaticResource DeleteToolButton}" Height="25" Width="30" ToolTip="删除便签" AutomationProperties.Name="删除便签" Click="OnDelete">
      <ui:SymbolIcon Style="{StaticResource DeleteIcon}" />
     </Button>
     <Button x:Name="SaveStatus" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Height="25" FontSize="10" Foreground="{DynamicResource Muted}" Content="已保存" Click="OnSave" ToolTip="保存（Ctrl+S）" />
     <WrapPanel>
      <Button x:Name="ModeButton" Style="{StaticResource ToolButton}" FontSize="11" Content="富文本 ▾" ToolTip="切换编辑格式" Click="OnFormatMenu">
       <Button.ContextMenu><ContextMenu>
        <MenuItem x:Name="RichFormatItem" Header="富文本" Tag="RichText" IsCheckable="True" Click="OnChangeFormat" />
        <MenuItem x:Name="MarkdownFormatItem" Header="Markdown" Tag="Markdown" IsCheckable="True" Click="OnChangeFormat" />
        <MenuItem x:Name="PlainFormatItem" Header="纯文本" Tag="PlainText" IsCheckable="True" Click="OnChangeFormat" />
       </ContextMenu></Button.ContextMenu>
      </Button>
      <Button x:Name="FormatButton" Style="{StaticResource ToolButton}" FontSize="11" Content="排版" Click="OnFormatBar" />
      <Button x:Name="LinkButton" Style="{StaticResource ToolButton}" FontSize="11" Content="链接" ToolTip="插入文件、文件夹或网页链接" Focusable="False" Click="OnLink" />
      <StackPanel x:Name="MarkdownButtons" Orientation="Horizontal" Visibility="Collapsed">
       <ToggleButton x:Name="SourceButton" Style="{StaticResource ToolToggle}" FontSize="11" Content="源码" Click="OnSource" />
       <ToggleButton x:Name="PreviewButton" Style="{StaticResource ToolToggle}" FontSize="11" Content="预览" Click="OnPreview" />
      </StackPanel>
     </WrapPanel>
    </DockPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
