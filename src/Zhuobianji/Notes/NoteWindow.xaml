<Window x:Class="Zhuobianji.NoteWindow" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Zhuobianji"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="桌边记" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize" ShowInTaskbar="False"
 Background="Transparent" Foreground="{DynamicResource Text}" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
 <!-- 窗口四周有 12 的阴影边距（NoteWindow.ShadowMargin）：标题区 = 12 + 顶栏 42，缩放边 = 12 + 卡片边缘 4。 -->
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="16" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
 </shell:WindowChrome.WindowChrome>
 <!-- 颜色资源由 NoteTheme.ApplyTo 在构造时写入；控件样式见 Theme/NoteStyles.xaml。 -->
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Zhuobianji;component/Theme/NoteStyles.xaml" />
   </ResourceDictionary.MergedDictionaries>
   <!-- 收纳标签的右键菜单：每个标签一份，DataContext 是对应的子便签窗口。 -->
   <ContextMenu x:Key="CollectionTabMenu" x:Shared="False">
    <MenuItem Header="展开" Click="OnTabExpand"><MenuItem.Icon><ui:SymbolIcon Symbol="Open20" /></MenuItem.Icon></MenuItem>
    <MenuItem Header="收起" Click="OnTabCollapse"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowMinimize20" /></MenuItem.Icon></MenuItem>
    <MenuItem Header="取出" Click="OnTabTakeOut"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowExport20" /></MenuItem.Icon></MenuItem>
    <Separator />
    <MenuItem Header="删除这张" Click="OnTabDelete"><MenuItem.Icon><ui:SymbolIcon Style="{StaticResource DeleteIcon}" /></MenuItem.Icon></MenuItem>
   </ContextMenu>
  </ResourceDictionary>
 </Window.Resources>
 <Grid>
  <Grid x:Name="Frame" Margin="12">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="0" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <!-- 左侧标签区：只有主便签有宽度；关闭标签时保留透明区域，窗口边界不变。
        标签像活页本的索引贴，右端伸到卡片下面 10px；放不下时先压矮，再用滚轮滚动，不显示滚动条。 -->
   <Grid x:Name="RailViewport" Grid.Column="0" Margin="0,48,-10,6" ClipToBounds="True">
    <Grid x:Name="CollectionRail" Visibility="Collapsed">
     <Grid.RenderTransform><TranslateTransform x:Name="RailTranslation" /></Grid.RenderTransform>
     <ScrollViewer x:Name="CollectionScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" AllowDrop="True"
      DragOver="OnCollectionDragOver" DragLeave="OnCollectionDragLeave" Drop="OnCollectionDrop" ScrollChanged="OnCollectionScrolled" SizeChanged="OnCollectionResized">
      <StackPanel>
       <StackPanel x:Name="CollectionTabs" Background="Transparent" />
       <Button x:Name="CollectionNewButton" Style="{StaticResource NewTab}" ToolTip="新建收纳便签" AutomationProperties.Name="新建收纳便签" Click="OnNewCollected">
        <StackPanel Orientation="Horizontal">
         <ui:SymbolIcon Symbol="Add20" FontSize="13" />
         <TextBlock Text="新建" Margin="4,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
       </Button>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Grid>
   <!-- 卡片阴影：贴边的短阴影加外圈的柔和阴影，外层缓存成位图，正文变化时不重画阴影。 -->
   <Grid Grid.Column="1" CacheMode="BitmapCache" IsHitTestVisible="False">
    <Border Style="{StaticResource CardShadow}" />
    <Border Style="{StaticResource CardContact}" />
   </Grid>
   <Border x:Name="NoteCard" Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="10" RenderOptions.ClearTypeHint="Enabled">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="42" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" MinHeight="36" />
     </Grid.RowDefinitions>
     <!-- 顶栏上浅下深，上沿一道亮线、下沿一道暗线，往正文上投一点阴影。 -->
     <Border x:Name="HeaderBand" Background="{DynamicResource HeaderFill}" BorderBrush="{DynamicResource Bevel}" BorderThickness="0,1,0,1" CornerRadius="9,9,0,0" TextOptions.TextFormattingMode="Display">
      <DockPanel Margin="14,0,6,0">
       <ContentControl DockPanel.Dock="Right" Style="{StaticResource KeyTray}">
        <StackPanel Orientation="Horizontal">
         <ToggleButton x:Name="CollectionRailToggle" Style="{StaticResource IconToggle}" Click="OnToggleRail" Visibility="Collapsed" AutomationProperties.Name="左侧标签">
          <ui:SymbolIcon Symbol="PanelLeft20" />
         </ToggleButton>
         <Border Style="{StaticResource ToolSeparator}" Visibility="{Binding Visibility, ElementName=CollectionRailToggle}" />
         <Button Style="{StaticResource IconButton}" ToolTip="新建便签（Ctrl+N）" AutomationProperties.Name="新建便签" Click="OnNewNote">
          <ui:SymbolIcon Symbol="Add20" />
         </Button>
         <ToggleButton x:Name="PinButton" Style="{StaticResource IconToggle}" Margin="2,0,0,0" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="置顶" Click="OnTogglePinned">
          <ui:SymbolIcon x:Name="PinIcon" Symbol="Pin20" />
         </ToggleButton>
         <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Margin="2,0,0,0" ToolTip="更多操作" AutomationProperties.Name="更多操作" Click="OnMore">
          <ui:SymbolIcon Symbol="MoreHorizontal20" />
          <Button.ContextMenu><ContextMenu>
           <MenuItem Header="新建富文本便签" Click="OnNewRich"><MenuItem.Icon><ui:SymbolIcon Symbol="DocumentText20" /></MenuItem.Icon></MenuItem>
           <MenuItem Header="新建 Markdown 便签" Click="OnNewMarkdown"><MenuItem.Icon><ui:SymbolIcon Symbol="Markdown20" /></MenuItem.Icon></MenuItem>
           <MenuItem Header="新建纯文本便签" Click="OnNewPlain"><MenuItem.Icon><ui:SymbolIcon Symbol="TextT20" /></MenuItem.Icon></MenuItem>
           <Separator />
           <MenuItem Header="设置…" Click="OnAppearance"><MenuItem.Icon><ui:SymbolIcon Symbol="Settings20" /></MenuItem.Icon></MenuItem>
           <MenuItem x:Name="SetMainItem" Header="设为主便签" Click="OnSetMain"><MenuItem.Icon><ui:SymbolIcon Symbol="PanelLeft20" /></MenuItem.Icon></MenuItem>
           <MenuItem x:Name="CollectItem" Header="收纳到主便签" Click="OnCollect" Visibility="Collapsed"><MenuItem.Icon><ui:SymbolIcon Symbol="Archive20" /></MenuItem.Icon></MenuItem>
           <MenuItem x:Name="DesktopMenuItem" Header="贴到桌面" Click="OnDesktop"><MenuItem.Icon><ui:SymbolIcon Symbol="Desktop20" /></MenuItem.Icon></MenuItem>
           <MenuItem x:Name="FloatingMenuItem" Header="恢复普通浮窗" Click="OnFloating"><MenuItem.Icon><ui:SymbolIcon Symbol="Window20" /></MenuItem.Icon></MenuItem>
           <Separator />
           <MenuItem Header="显示所有便签" Click="OnShowAll"><MenuItem.Icon><ui:SymbolIcon Symbol="WindowMultiple20" /></MenuItem.Icon></MenuItem>
           <MenuItem Header="关闭这张便签" InputGestureText="Ctrl+W" Click="OnHide"><MenuItem.Icon><ui:SymbolIcon Symbol="Dismiss20" /></MenuItem.Icon></MenuItem>
           <MenuItem Header="删除这张便签" Click="OnDelete"><MenuItem.Icon><ui:SymbolIcon Style="{StaticResource DeleteIcon}" /></MenuItem.Icon></MenuItem>
           <Separator />
           <MenuItem Header="退出程序" InputGestureText="Ctrl+Shift+Q" Click="OnExit"><MenuItem.Icon><ui:SymbolIcon Symbol="Power20" /></MenuItem.Icon></MenuItem>
          </ContextMenu></Button.ContextMenu>
         </Button>
         <Border Style="{StaticResource ToolSeparator}" />
         <Button x:Name="CloseButton" Style="{StaticResource DangerIconButton}" ToolTip="关闭便签（Ctrl+W）" AutomationProperties.Name="关闭便签" Click="OnHide">
          <ui:SymbolIcon Symbol="Dismiss20" />
         </Button>
        </StackPanel>
       </ContentControl>
       <!-- 普通便签顶栏不写标题，只当拖动区；主便签显示一个小标签。 -->
       <Border x:Name="MainTag" Style="{StaticResource Tag}" Visibility="Collapsed"><TextBlock Text="主便签" /></Border>
      </DockPanel>
     </Border>
     <Border Grid.Row="1" Height="6" VerticalAlignment="Top" Background="{DynamicResource HeaderShade}" IsHitTestVisible="False" />
     <local:NoteEditor x:Name="OwnEditor" Grid.Row="1" Margin="22,10,14,8" />
     <Border x:Name="FormatBar" Grid.Row="2" Style="{StaticResource FormatTray}" Visibility="Collapsed" TextOptions.TextFormattingMode="Display">
      <WrapPanel>
       <Button Style="{StaticResource IconButton}" ToolTip="粗体（Ctrl+B）" Focusable="False" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=OwnEditor, Path=RichEditor}"><ui:SymbolIcon Symbol="TextBold20" /></Button>
       <Button Style="{StaticResource IconButton}" ToolTip="斜体（Ctrl+I）" Focusable="False" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=OwnEditor, Path=RichEditor}"><ui:SymbolIcon Symbol="TextItalic20" /></Button>
       <Button Style="{StaticResource IconButton}" ToolTip="下划线（Ctrl+U）" Focusable="False" Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=OwnEditor, Path=RichEditor}"><ui:SymbolIcon Symbol="TextUnderline20" /></Button>
       <Button Style="{StaticResource IconButton}" ToolTip="删除线" Focusable="False" Click="OnStrike"><ui:SymbolIcon Symbol="TextStrikethrough20" /></Button>
       <Border Style="{StaticResource ToolSeparator}" />
       <Button Style="{StaticResource IconButton}" ToolTip="项目符号" Focusable="False" Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=OwnEditor, Path=RichEditor}"><ui:SymbolIcon Symbol="TextBulletListLtr20" /></Button>
       <Button Style="{StaticResource IconButton}" ToolTip="编号列表" Focusable="False" Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=OwnEditor, Path=RichEditor}"><ui:SymbolIcon Symbol="TextNumberListLtr20" /></Button>
       <Border Style="{StaticResource ToolSeparator}" />
       <Button x:Name="ColorButton" Style="{StaticResource IconButton}" ToolTip="文字颜色" Focusable="False" Click="OnTextColor">
        <Grid>
         <ui:SymbolIcon Symbol="TextColor20" />
         <!-- 盖住图标自带的空心色条，显示选中文字的颜色。 -->
         <Border x:Name="ColorBar" Width="12" Height="4" CornerRadius="1" VerticalAlignment="Bottom" Margin="0,0,0,2" Background="{DynamicResource Text}" />
        </Grid>
       </Button>
      </WrapPanel>
     </Border>
     <DockPanel Grid.Row="3" Margin="10,2,4,4" TextOptions.TextFormattingMode="Display">
      <ResizeGrip DockPanel.Dock="Right" Width="14" Height="14" VerticalAlignment="Bottom" shell:WindowChrome.ResizeGripDirection="BottomRight" />
      <Button x:Name="DeleteButton" DockPanel.Dock="Right" Style="{StaticResource DangerIconButton}" ToolTip="删除便签" AutomationProperties.Name="删除便签" Click="OnDelete">
       <ui:SymbolIcon Style="{StaticResource DeleteIcon}" />
      </Button>
      <!-- 保存状态：平时一个很淡的勾，保存中更淡，失败时显示红字；状态文字在提示里。 -->
      <Button x:Name="SaveStatus" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Padding="6,0" Margin="0,0,2,0" Click="OnSave">
       <Grid>
        <ui:SymbolIcon x:Name="SaveIcon" Symbol="Checkmark20" FontSize="14" Foreground="{DynamicResource Muted}" Opacity="0.6" />
        <TextBlock x:Name="SaveErrorText" Text="保存失败 · 点击重试" FontSize="11" Foreground="{DynamicResource Error}" Visibility="Collapsed" />
       </Grid>
      </Button>
      <WrapPanel VerticalAlignment="Center">
       <Button x:Name="ModeButton" Style="{StaticResource KeyButton}" Height="26" Padding="9,0,6,0" Margin="0,0,4,0" ToolTip="切换编辑格式" Click="OnFormatMenu">
        <StackPanel Orientation="Horizontal">
         <TextBlock x:Name="ModeLabel" Text="富文本" VerticalAlignment="Center" />
         <ui:SymbolIcon Symbol="ChevronDown20" FontSize="12" Margin="4,1,0,0" Foreground="{DynamicResource Muted}" />
        </StackPanel>
        <Button.ContextMenu><ContextMenu>
         <MenuItem x:Name="RichFormatItem" Header="富文本" Tag="RichText" IsCheckable="True" Click="OnChangeFormat" />
         <MenuItem x:Name="MarkdownFormatItem" Header="Markdown" Tag="Markdown" IsCheckable="True" Click="OnChangeFormat" />
         <MenuItem x:Name="PlainFormatItem" Header="纯文本" Tag="PlainText" IsCheckable="True" Click="OnChangeFormat" />
        </ContextMenu></Button.ContextMenu>
       </Button>
       <ToggleButton x:Name="FormatButton" Style="{StaticResource IconToggle}" Margin="2,0,0,0" ToolTip="排版工具" AutomationProperties.Name="排版" Focusable="False" Click="OnFormatBar">
        <ui:SymbolIcon Symbol="TextEditStyle20" />
       </ToggleButton>
       <Button x:Name="LinkButton" Style="{StaticResource IconButton}" Margin="2,0,0,0" ToolTip="插入链接：文件、文件夹或网页" AutomationProperties.Name="链接" Focusable="False" Click="OnLink">
        <ui:SymbolIcon Symbol="Link20" />
       </Button>
       <StackPanel x:Name="MarkdownButtons" Orientation="Horizontal" Visibility="Collapsed">
        <ToggleButton x:Name="SourceButton" Style="{StaticResource IconToggle}" Margin="2,0,0,0" ToolTip="源码" AutomationProperties.Name="源码" Click="OnSource"><ui:SymbolIcon Symbol="Code20" /></ToggleButton>
        <ToggleButton x:Name="PreviewButton" Style="{StaticResource IconToggle}" Margin="2,0,0,0" ToolTip="预览" AutomationProperties.Name="预览" Click="OnPreview"><ui:SymbolIcon Symbol="Eye20" /></ToggleButton>
       </StackPanel>
      </WrapPanel>
     </DockPanel>
    </Grid>
   </Border>
   <!-- 文字颜色：排版栏颜色按钮上方弹出一排色块，当前颜色外圈实线。 -->
   <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorButton}" Placement="Top" HorizontalOffset="-12" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
    <ContentControl Style="{StaticResource PopupCard}" Padding="4">
     <StackPanel x:Name="ColorSwatches" Orientation="Horizontal" />
    </ContentControl>
   </Popup>
  </Grid>
 </Grid>
</Window>
