<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AssemblyName>Zhuobianji</AssemblyName>
    <Version>0.8.9</Version>
    <Product>桌边记</Product>
    <AssemblyTitle>桌边记</AssemblyTitle>
    <Company>桌边记</Company>
    <DebugType>embedded</DebugType>
    <ApplicationIcon>Assets\zhuobianji.ico</ApplicationIcon>
    <Description>桌边记</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\zhuobianji.ico" LogicalName="Zhuobianji.Icon" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="Zhuobianji.Notices.LICENSE" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="Zhuobianji.Notices.THIRD-PARTY-NOTICES.txt" />
    <EmbeddedResource Include="..\..\WPF-UI-THIRD-PARTY-NOTICES.txt" LogicalName="Zhuobianji.Notices.WPF-UI-THIRD-PARTY-NOTICES.txt" />
    <EmbeddedResource Include="..\..\DOTNET-THIRD-PARTY-NOTICES.txt" LogicalName="Zhuobianji.Notices.DOTNET-THIRD-PARTY-NOTICES.txt" />
    <ProjectReference Include="..\Zhuobianji.Core\Zhuobianji.Core.csproj" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="AngleSharp" Version="1.8.3" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <InternalsVisibleTo Include="Zhuobianji.Checks" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.txt" Link="docs\THIRD-PARTY-NOTICES.txt" ExcludeFromSingleFile="true" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\WPF-UI-THIRD-PARTY-NOTICES.txt" Link="docs\WPF-UI-THIRD-PARTY-NOTICES.txt" ExcludeFromSingleFile="true" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\DOTNET-THIRD-PARTY-NOTICES.txt" Link="docs\DOTNET-THIRD-PARTY-NOTICES.txt" ExcludeFromSingleFile="true" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
