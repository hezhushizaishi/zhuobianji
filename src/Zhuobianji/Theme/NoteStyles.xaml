<ResourceDictionary
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:local="clr-namespace:Zhuobianji"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
 <!-- 便签窗口、弹窗和托盘菜单的控件样式。颜色只引用 NoteTheme.ApplyTo 写入的资源键：
      Surface Header HeaderFill HeaderShade Text Muted Edge Accent Subtle Selected
      Shine Shade Raised Glow Inset Bevel Groove Etch Danger OnDanger Error。 -->
 <ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Fonts.xaml" />
 </ResourceDictionary.MergedDictionaries>

 <!-- 规范：图标 16px（20 号字形）；按钮高 28、圆角 6，卡片和弹窗圆角 8，便签 10；间距取 4 / 8 / 12 / 16；
      说明文字 11 号，按钮和菜单 12 号。键盘焦点画一圈描边。
      立体感：光从上方来。凸起的东西上沿亮、下沿一道暗边（Raised + Bevel + 下方 1px Shade），
      凹进去的上沿暗（Inset + Groove）。图标按钮平时是平的，悬停浮起（NoteTheme.Fast 淡入），按下和开启时凹进去。 -->
 <Style x:Key="Icon" TargetType="ui:SymbolIcon">
  <Setter Property="FontFamily" Value="{StaticResource FluentSystemIcons}" />
  <Setter Property="FontSize" Value="16" />
 </Style>
 <Style TargetType="ui:SymbolIcon" BasedOn="{StaticResource Icon}" />

 <Style x:Key="FocusRing">
  <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
   <Border Margin="-2" CornerRadius="8" BorderBrush="{DynamicResource Muted}" BorderThickness="1.5" />
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- 文字按钮（链接卡片上的操作、保存状态）；图标按钮基于它。平时是平的，悬停浮起一枚键面，按下凹进去。
      开关（ToggleButton）开启时保持凹进去的样子，底色画在 Fill 上。 -->
 <Style x:Key="ToolButton" TargetType="ButtonBase">
  <Setter Property="Background" Value="Transparent" />
  <Setter Property="BorderBrush" Value="Transparent" />
  <Setter Property="Foreground" Value="{DynamicResource Text}" />
  <Setter Property="BorderThickness" Value="0" />
  <Setter Property="Height" Value="28" />
  <Setter Property="MinWidth" Value="28" />
  <Setter Property="Padding" Value="8,0" />
  <Setter Property="FontSize" Value="12" />
  <Setter Property="Cursor" Value="Hand" />
  <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
  <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
  <Setter Property="Template">
   <Setter.Value><ControlTemplate TargetType="ButtonBase">
    <Grid Background="Transparent">
     <Grid x:Name="Raise" Opacity="0">
      <Border Background="{DynamicResource Shade}" CornerRadius="6" Margin="0,1,0,-1" />
      <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Shine}" BorderThickness="0,1,0,0" CornerRadius="6" />
     </Grid>
     <Border x:Name="Fill" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="6" />
     <Border x:Name="Press" Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Shade}" BorderThickness="0,1,0,0" CornerRadius="6" Opacity="0" />
     <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True">
      <Trigger.EnterActions><BeginStoryboard><Storyboard>
       <DoubleAnimation Storyboard.TargetName="Raise" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static local:NoteTheme.Fast}" EasingFunction="{x:Static local:NoteTheme.Ease}" />
      </Storyboard></BeginStoryboard></Trigger.EnterActions>
      <Trigger.ExitActions><BeginStoryboard><Storyboard FillBehavior="Stop">
       <DoubleAnimation Storyboard.TargetName="Raise" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static local:NoteTheme.Fast}" EasingFunction="{x:Static local:NoteTheme.Ease}" />
      </Storyboard></BeginStoryboard></Trigger.ExitActions>
     </Trigger>
     <Trigger Property="ToggleButton.IsChecked" Value="True">
      <Setter TargetName="Raise" Property="Visibility" Value="Hidden" />
      <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Inset}" />
      <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource Shade}" />
      <Setter TargetName="Content" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1" /></Setter.Value></Setter>
     </Trigger>
     <Trigger Property="IsPressed" Value="True">
      <Setter TargetName="Raise" Property="Visibility" Value="Hidden" />
      <Setter TargetName="Press" Property="Opacity" Value="1" />
      <Setter TargetName="Content" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1" /></Setter.Value></Setter>
     </Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value>
  </Setter>
 </Style>

 <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolButton}" />

 <!-- 图标按钮：28×28，平时淡色，悬停变实。 -->
 <Style x:Key="IconButton" TargetType="ButtonBase" BasedOn="{StaticResource ToolButton}">
  <Setter Property="Width" Value="28" />
  <Setter Property="Padding" Value="0" />
  <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text}" /></Trigger>
  </Style.Triggers>
 </Style>

 <!-- 开关型图标按钮（置顶、标签、排版、源码 / 预览）：开启时凹进去、图标变实。 -->
 <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
  <Style.Triggers>
   <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text}" /></Trigger>
  </Style.Triggers>
 </Style>

 <Style x:Key="DeleteIcon" TargetType="ui:SymbolIcon" BasedOn="{StaticResource Icon}">
  <Setter Property="Symbol" Value="Delete20" />
 </Style>

 <!-- 关闭、删除：悬停变红。 -->
 <Style x:Key="DangerIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></Trigger>
  </Style.Triggers>
 </Style>

 <!-- 凸起的按键（「富文本 ⌄」、弹窗按钮）：平时就是浮起的键面，悬停提亮，按下凹进去。 -->
 <Style x:Key="KeyButton" TargetType="ButtonBase" BasedOn="{StaticResource ToolButton}">
  <Setter Property="Background" Value="{DynamicResource Raised}" />
  <Setter Property="BorderBrush" Value="{DynamicResource Bevel}" />
  <Setter Property="Padding" Value="12,0" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ButtonBase">
   <Grid Background="Transparent">
    <Border x:Name="Lip" Background="{DynamicResource Shade}" CornerRadius="6" Margin="0,1,0,-1" />
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" />
    <Border x:Name="Hover" Background="{DynamicResource Glow}" CornerRadius="6" Opacity="0" />
    <Border x:Name="Press" Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Shade}" BorderThickness="0,1,0,0" CornerRadius="6" Opacity="0" />
    <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Trigger.EnterActions><BeginStoryboard><Storyboard>
      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static local:NoteTheme.Fast}" EasingFunction="{x:Static local:NoteTheme.Ease}" />
     </Storyboard></BeginStoryboard></Trigger.EnterActions>
     <Trigger.ExitActions><BeginStoryboard><Storyboard FillBehavior="Stop">
      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static local:NoteTheme.Fast}" EasingFunction="{x:Static local:NoteTheme.Ease}" />
     </Storyboard></BeginStoryboard></Trigger.ExitActions>
    </Trigger>
    <Trigger Property="IsPressed" Value="True">
     <Setter TargetName="Lip" Property="Visibility" Value="Hidden" />
     <Setter TargetName="Press" Property="Opacity" Value="1" />
     <Setter TargetName="Content" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1" /></Setter.Value></Setter>
    </Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- 弹窗里的确认按钮：墨色实底；危险操作红底。 -->
 <Style x:Key="PrimaryButton" TargetType="ButtonBase" BasedOn="{StaticResource KeyButton}">
  <Setter Property="Background" Value="{DynamicResource Text}" />
  <Setter Property="Foreground" Value="{DynamicResource Surface}" />
 </Style>

 <Style x:Key="DangerButton" TargetType="ButtonBase" BasedOn="{StaticResource KeyButton}">
  <Setter Property="Background" Value="{DynamicResource Danger}" />
  <Setter Property="Foreground" Value="{DynamicResource OnDanger}" />
 </Style>

 <!-- 凸起的按键托：顶栏右侧那组按钮、底栏的格式按钮放在里面。 -->
 <Style x:Key="KeyTray" TargetType="ContentControl">
  <Setter Property="Focusable" Value="False" />
  <Setter Property="Padding" Value="2" />
  <Setter Property="VerticalAlignment" Value="Center" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <Grid>
    <Border Background="{DynamicResource Shade}" CornerRadius="8" Margin="0,1,0,-1" />
    <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Bevel}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter />
    </Border>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- 左侧标签区的按钮（「＋ 新建」）。 -->
 <Style x:Key="RailButton" TargetType="ButtonBase" BasedOn="{StaticResource ToolButton}">
  <Setter Property="Background" Value="{DynamicResource Surface}" />
  <Setter Property="Height" Value="38" />
  <Setter Property="Width" Value="84" />
  <Setter Property="FontSize" Value="12" />
  <Setter Property="Padding" Value="8,0,4,0" />
  <Setter Property="Margin" Value="0,0,0,6" />
  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ButtonBase">
   <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Accent}" /></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Text}" /></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="TabBorder" Property="Opacity" Value="0.7" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- 收纳标签：标题过长省略；展开时（IsChecked）强调底色、箭头朝左。 -->
 <Style x:Key="CollectionTab" TargetType="ToggleButton" BasedOn="{StaticResource RailButton}">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
   <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
    <DockPanel VerticalAlignment="Center">
     <TextBlock x:Name="Arrow" DockPanel.Dock="Right" Width="12" TextAlignment="Center" Text="›" />
     <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextTrimming="CharacterEllipsis" />
    </DockPanel>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="‹" /></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Accent}" /></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Text}" /></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="TabBorder" Property="Opacity" Value="0.7" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
  <Style.Triggers>
   <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}" /></Trigger>
  </Style.Triggers>
 </Style>

 <!-- 便签上弹出的小卡片（链接卡片、文字颜色）：外边距留给阴影，阴影单独一层。 -->
 <Style x:Key="PopupCard" TargetType="ContentControl">
  <Setter Property="Background" Value="{DynamicResource Surface}" />
  <Setter Property="Foreground" Value="{DynamicResource Text}" />
  <Setter Property="BorderBrush" Value="{DynamicResource Edge}" />
  <Setter Property="Padding" Value="6" />
  <Setter Property="Focusable" Value="False" />
  <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
  <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <Grid Margin="6,4,6,8">
    <Border Background="{TemplateBinding Background}" CornerRadius="8">
     <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.16" /></Border.Effect>
    </Border>
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter />
    </Border>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <Style x:Key="LinkCardAddress" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  <Setter Property="FontSize" Value="12" />
  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
 </Style>

 <!-- 卡片上的按钮不抢焦点，光标留在正文里。 -->
 <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
  <Setter Property="Height" Value="26" />
  <Setter Property="FontSize" Value="12" />
  <Setter Property="Padding" Value="6,0" />
  <Setter Property="Focusable" Value="False" />
 </Style>

 <!-- 便签窗口：卡片阴影画在背后单独一层（贴边的短阴影 + 外圈的柔和阴影），外层缓存成位图，打字时不重算。 -->
 <Style x:Key="CardShadow" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource Surface}" />
  <Setter Property="CornerRadius" Value="10" />
  <Setter Property="IsHitTestVisible" Value="False" />
  <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.15" /></Setter.Value></Setter>
 </Style>

 <Style x:Key="CardContact" TargetType="Border" BasedOn="{StaticResource CardShadow}">
  <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.18" /></Setter.Value></Setter>
 </Style>

 <!-- 顶栏上的小标签（「主便签」）：浅浅压进去。 -->
 <Style x:Key="Tag" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource Inset}" />
  <Setter Property="BorderBrush" Value="{DynamicResource Groove}" />
  <Setter Property="BorderThickness" Value="1" />
  <Setter Property="CornerRadius" Value="5" />
  <Setter Property="Padding" Value="7,2,7,3" />
  <Setter Property="HorizontalAlignment" Value="Left" />
  <Setter Property="VerticalAlignment" Value="Center" />
  <Setter Property="TextElement.FontSize" Value="11" />
  <Setter Property="TextElement.Foreground" Value="{DynamicResource Muted}" />
 </Style>

 <!-- 排版栏：底栏上方一道凹槽，按「字形 | 列表 | 颜色」分组。 -->
 <Style x:Key="FormatTray" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource Inset}" />
  <Setter Property="BorderBrush" Value="{DynamicResource Groove}" />
  <Setter Property="BorderThickness" Value="1" />
  <Setter Property="CornerRadius" Value="8" />
  <Setter Property="Padding" Value="2" />
  <Setter Property="Margin" Value="10,0,10,2" />
 </Style>

 <!-- 分隔线：刻进去的一道细缝（左暗右亮）。 -->
 <Style x:Key="ToolSeparator" TargetType="Border">
  <Setter Property="Width" Value="2" />
  <Setter Property="Height" Value="16" />
  <Setter Property="Margin" Value="4,0" />
  <Setter Property="VerticalAlignment" Value="Center" />
  <Setter Property="Background" Value="{DynamicResource Etch}" />
 </Style>

 <!-- 文字颜色色块：当前颜色外圈实线，悬停淡圈。 -->
 <Style x:Key="Swatch" TargetType="ToggleButton">
  <Setter Property="Width" Value="28" />
  <Setter Property="Height" Value="28" />
  <Setter Property="Cursor" Value="Hand" />
  <Setter Property="Focusable" Value="False" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
   <Grid Background="Transparent">
    <Ellipse x:Name="Ring" Margin="1" Stroke="{DynamicResource Text}" StrokeThickness="1.5" Opacity="0" />
    <Ellipse Margin="5" Fill="{TemplateBinding Background}" />
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="0.35" /></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- 右下角缩放角：两道淡色斜线，深浅色都不抢眼。 -->
 <Style TargetType="ResizeGrip">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ResizeGrip">
   <Grid Background="Transparent">
    <Path Data="M 10,2 L 2,10 M 10,6 L 6,10" Stroke="{DynamicResource Muted}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
     Opacity="0.55" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" />
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- 细滚动条：没有箭头，滑块平时细而淡，悬停时加宽加深。 -->
 <Style x:Key="ScrollPage" TargetType="RepeatButton">
  <Setter Property="Focusable" Value="False" />
  <Setter Property="IsTabStop" Value="False" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
 </Style>

 <Style x:Key="ScrollThumb" TargetType="Thumb">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
   <Border x:Name="Bar" Background="{DynamicResource Muted}" CornerRadius="3" Opacity="0.35" />
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Opacity" Value="0.6" /></Trigger>
    <Trigger Property="IsDragging" Value="True"><Setter TargetName="Bar" Property="Opacity" Value="0.75" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <Style TargetType="ScrollBar">
  <Setter Property="Width" Value="10" />
  <Setter Property="MinWidth" Value="10" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
   <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="3,2">
    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" /></Track.DecreaseRepeatButton>
    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" /></Track.IncreaseRepeatButton>
    <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
   </Track>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PART_Track" Property="Margin" Value="2" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
  <Style.Triggers>
   <Trigger Property="Orientation" Value="Horizontal">
    <Setter Property="Width" Value="Auto" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Height" Value="10" />
    <Setter Property="MinHeight" Value="10" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
     <Track x:Name="PART_Track" Margin="2,3">
      <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" /></Track.DecreaseRepeatButton>
      <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" /></Track.IncreaseRepeatButton>
      <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
     </Track>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PART_Track" Property="Margin" Value="2" /></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Trigger>
  </Style.Triggers>
 </Style>

 <!-- 菜单和提示：底色跟随便签，圆角 8 / 6，阴影单独一层，不让文字走特效渲染。 -->
 <Style TargetType="ContextMenu">
  <Setter Property="Background" Value="{DynamicResource Surface}" />
  <Setter Property="Foreground" Value="{DynamicResource Text}" />
  <Setter Property="BorderBrush" Value="{DynamicResource Edge}" />
  <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
  <Setter Property="FontSize" Value="12" />
  <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  <Setter Property="MinWidth" Value="168" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
   <Grid Margin="6">
    <Border Background="{TemplateBinding Background}" CornerRadius="8">
     <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.16" /></Border.Effect>
    </Border>
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
     <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
    </Border>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- 菜单项：左列图标（可勾选的项在这里显示对勾），右侧快捷键。 -->
 <Style TargetType="MenuItem">
  <Setter Property="Foreground" Value="{DynamicResource Text}" />
  <Setter Property="Padding" Value="8,0,12,0" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
   <Grid x:Name="Row" Height="30" Background="Transparent" SnapsToDevicePixels="True">
    <Border x:Name="Highlight" Background="{DynamicResource Subtle}" CornerRadius="5" Opacity="0" />
    <Grid Margin="{TemplateBinding Padding}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <ContentPresenter x:Name="IconHost" ContentSource="Icon" HorizontalAlignment="Left" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Muted}" />
     <ui:SymbolIcon x:Name="Check" Style="{StaticResource Icon}" Symbol="Checkmark20" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
     <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
     <TextBlock x:Name="Gesture" Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource Muted}" FontSize="11" />
    </Grid>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Highlight" Property="Opacity" Value="1" /></Trigger>
    <Trigger Property="IsChecked" Value="True">
     <Setter TargetName="Check" Property="Visibility" Value="Visible" />
     <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
    </Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.4" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
   <Border Height="1" Margin="8,4" Background="{DynamicResource Edge}" />
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <Style TargetType="ToolTip">
  <Setter Property="Background" Value="{DynamicResource Surface}" />
  <Setter Property="Foreground" Value="{DynamicResource Text}" />
  <Setter Property="BorderBrush" Value="{DynamicResource Edge}" />
  <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
  <Setter Property="FontSize" Value="12" />
  <Setter Property="Padding" Value="8,5" />
  <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  <Setter Property="MaxWidth" Value="372" />
