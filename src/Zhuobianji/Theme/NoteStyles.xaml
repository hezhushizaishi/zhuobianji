<ResourceDictionary
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:local="clr-namespace:Zhuobianji"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
 <!-- 便签窗口、弹窗和托盘菜单的控件样式。颜色只引用 NoteTheme.ApplyTo 写入的资源键：
      Surface Header HeaderFill HeaderShade Text Muted Edge Accent Subtle Selected
      Shine Shade Raised Glow Inset Bevel Groove Etch Danger OnDanger Error。 -->
 <ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Fonts.xaml" />
 </ResourceDictionary.MergedDictionaries>

 <!-- 规范：图标 16px（20 号字形）；按钮高 28、圆角 6（弹窗里的按键和输入框高 30），键托、卡片和弹窗圆角 8，便签 10；
      间距取 4 / 8 / 12 / 16；说明文字 11 号，按钮和菜单 12 号，弹窗正文 13 号。键盘焦点画一圈描边。
      立体感只有一种做法：光从上方来，凸起的东西上沿亮、下沿一道暗边（Raised + Bevel + 下方 1px Shade）。
      便签上能点的按钮都放在键托（KeyTray）上：顶栏左右各一个、底栏左右各一个、排版栏一个，离卡片边缘都是 6。
      托里的按键平时是平的，悬停浮起（NoteTheme.Fast 淡入），按下和开启时凹进去；凹只表示按下或开启，不拿来装饰。
      左侧标签用同一种凸起（圆角 8、上亮下暗、底下一道暗边），尺寸由代码按主便签大小换算（NoteWindow.Collection）。 -->
 <Style x:Key="Icon" TargetType="ui:SymbolIcon">
  <Setter Property="FontFamily" Value="{StaticResource FluentSystemIcons}" />
  <Setter Property="FontSize" Value="16" />
 </Style>
 <Style TargetType="ui:SymbolIcon" BasedOn="{StaticResource Icon}" />

 <Style x:Key="FocusRing">
  <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
   <Border Margin="-2" CornerRadius="8" BorderBrush="{DynamicResource Muted}" BorderThickness="1.5" />
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- 文字按钮（链接卡片上的操作、保存状态）；图标按钮基于它。平时是平的，悬停浮起一枚键面，按下凹进去。
      开关（ToggleButton）开启时保持凹进去的样子，底色画在 Fill 上。 -->
 <Style x:Key="ToolButton" TargetType="ButtonBase">
  <Setter Property="Background" Value="Transparent" />
  <Setter Property="BorderBrush" Value="Transparent" />
  <Setter Property="Foreground" Value="{DynamicResource Text}" />
  <Setter Property="BorderThickness" Value="0" />
  <Setter Property="Height" Value="28" />
  <Setter Property="MinWidth" Value="28" />
  <Setter Property="Padding" Value="8,0" />
  <Setter Property="FontSize" Value="12" />
  <Setter Property="Cursor" Value="Hand" />
  <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
  <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
  <Setter Property="Template">
   <Setter.Value><ControlTemplate TargetType="ButtonBase">
    <Grid Background="Transparent">
     <Grid x:Name="Raise" Opacity="0">
      <Border Background="{DynamicResource Shade}" CornerRadius="6" Margin="0,1,0,-1" />
      <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Shine}" BorderThickness="0,1,0,0" CornerRadius="6" />
     </Grid>
     <Border x:Name="Fill" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="6" />
     <Border x:Name="Press" Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Shade}" BorderThickness="0,1,0,0" CornerRadius="6" Opacity="0" />
     <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True">
      <Trigger.EnterActions><BeginStoryboard><Storyboard>
       <DoubleAnimation Storyboard.TargetName="Raise" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static local:NoteTheme.Fast}" EasingFunction="{x:Static local:NoteTheme.Ease}" />
      </Storyboard></BeginStoryboard></Trigger.EnterActions>
      <Trigger.ExitActions><BeginStoryboard><Storyboard FillBehavior="Stop">
       <DoubleAnimation Storyboard.TargetName="Raise" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static local:NoteTheme.Fast}" EasingFunction="{x:Static local:NoteTheme.Ease}" />
      </Storyboard></BeginStoryboard></Trigger.ExitActions>
     </Trigger>
     <Trigger Property="ToggleButton.IsChecked" Value="True">
      <Setter TargetName="Raise" Property="Visibility" Value="Hidden" />
      <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Inset}" />
      <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource Shade}" />
      <Setter TargetName="Content" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1" /></Setter.Value></Setter>
     </Trigger>
     <Trigger Property="IsPressed" Value="True">
      <Setter TargetName="Raise" Property="Visibility" Value="Hidden" />
      <Setter TargetName="Press" Property="Opacity" Value="1" />
      <Setter TargetName="Content" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1" /></Setter.Value></Setter>
     </Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value>
  </Setter>
 </Style>

 <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolButton}" />

 <!-- 图标按钮：28×28，平时淡色，悬停变实。 -->
 <Style x:Key="IconButton" TargetType="ButtonBase" BasedOn="{StaticResource ToolButton}">
  <Setter Property="Width" Value="28" />
  <Setter Property="Padding" Value="0" />
  <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text}" /></Trigger>
  </Style.Triggers>
 </Style>

 <!-- 开关型图标按钮（置顶、排版、源码 / 预览）：开启时凹进去、图标变实。 -->
 <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
  <Style.Triggers>
   <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text}" /></Trigger>
  </Style.Triggers>
 </Style>

 <!-- 带文字的图标按钮（「富文本 ⌄」「主便签」）：和图标按钮一样平时淡色、悬停变实，宽度随内容。 -->
 <Style x:Key="LabelButton" TargetType="ButtonBase" BasedOn="{StaticResource IconButton}">
  <Setter Property="Width" Value="Auto" />
  <Setter Property="Padding" Value="8,0" />
 </Style>

 <Style x:Key="LabelToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggle}">
  <Setter Property="Width" Value="Auto" />
  <Setter Property="Padding" Value="8,0" />
 </Style>

 <Style x:Key="DeleteIcon" TargetType="ui:SymbolIcon" BasedOn="{StaticResource Icon}">
  <Setter Property="Symbol" Value="Delete20" />
 </Style>

 <!-- 关闭、删除：悬停变红。 -->
 <Style x:Key="DangerIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></Trigger>
  </Style.Triggers>
 </Style>

 <!-- 单独凸起的按键（弹窗按钮）：平时就是浮起的键面，和键托同一种做法；悬停提亮，按下凹进去。 -->
 <Style x:Key="KeyButton" TargetType="ButtonBase" BasedOn="{StaticResource ToolButton}">
  <Setter Property="Background" Value="{DynamicResource Raised}" />
  <Setter Property="BorderBrush" Value="{DynamicResource Bevel}" />
  <Setter Property="Height" Value="30" />
  <Setter Property="MinWidth" Value="72" />
  <Setter Property="Padding" Value="14,0" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ButtonBase">
   <Grid Background="Transparent">
    <Border x:Name="Lip" Background="{DynamicResource Shade}" CornerRadius="6" Margin="0,1,0,-1" />
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" />
    <Border x:Name="Hover" Background="{DynamicResource Glow}" CornerRadius="6" Opacity="0" />
    <Border x:Name="Press" Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Shade}" BorderThickness="0,1,0,0" CornerRadius="6" Opacity="0" />
    <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Trigger.EnterActions><BeginStoryboard><Storyboard>
      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static local:NoteTheme.Fast}" EasingFunction="{x:Static local:NoteTheme.Ease}" />
     </Storyboard></BeginStoryboard></Trigger.EnterActions>
     <Trigger.ExitActions><BeginStoryboard><Storyboard FillBehavior="Stop">
      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static local:NoteTheme.Fast}" EasingFunction="{x:Static local:NoteTheme.Ease}" />
     </Storyboard></BeginStoryboard></Trigger.ExitActions>
    </Trigger>
    <Trigger Property="IsPressed" Value="True">
     <Setter TargetName="Lip" Property="Visibility" Value="Hidden" />
     <Setter TargetName="Press" Property="Opacity" Value="1" />
     <Setter TargetName="Content" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1" /></Setter.Value></Setter>
    </Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- 弹窗里的确认按钮：墨色实底；危险操作红底。 -->
 <Style x:Key="PrimaryButton" TargetType="ButtonBase" BasedOn="{StaticResource KeyButton}">
  <Setter Property="Background" Value="{DynamicResource Text}" />
  <Setter Property="Foreground" Value="{DynamicResource Surface}" />
 </Style>

 <Style x:Key="DangerButton" TargetType="ButtonBase" BasedOn="{StaticResource KeyButton}">
  <Setter Property="Background" Value="{DynamicResource Danger}" />
  <Setter Property="Foreground" Value="{DynamicResource OnDanger}" />
 </Style>

 <!-- 凸起的键托：顶栏、底栏和排版栏的按钮都放在里面。 -->
 <Style x:Key="KeyTray" TargetType="ContentControl">
  <Setter Property="Focusable" Value="False" />
  <Setter Property="Padding" Value="2" />
  <Setter Property="VerticalAlignment" Value="Center" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <Grid>
    <Border Background="{DynamicResource Shade}" CornerRadius="8" Margin="0,1,0,-1" />
    <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Bevel}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter />
    </Border>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- 收纳标签：活页本的索引贴，右端一截压在卡片下面，只有外侧圆角。
      颜色取自那张子便签（代码把子便签的配色写进标签自己的资源）：收着时是子便签的顶栏色、字淡；
      展开（IsChecked）时底色和子便签正文一样、字变实。往外抽出的位移由代码控制（NoteWindow.Collection）。
      高、外边距、内边距和字号是代码按主便签大小写在标签区上的资源（TabHeight TabMargin TabPadding TabFontSize）。 -->
 <Style x:Key="CollectionTab" TargetType="ToggleButton">
  <Setter Property="Height" Value="{DynamicResource TabHeight}" />
  <Setter Property="Margin" Value="{DynamicResource TabMargin}" />
  <Setter Property="Padding" Value="{DynamicResource TabPadding}" />
  <Setter Property="FontSize" Value="{DynamicResource TabFontSize}" />
  <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  <Setter Property="Background" Value="{DynamicResource HeaderFill}" />
  <Setter Property="Cursor" Value="Hand" />
  <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
   <Grid Background="Transparent">
    <Border Background="{DynamicResource Shade}" CornerRadius="8,0,0,8" Margin="0,1,0,-1" />
    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Bevel}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="{TemplateBinding Padding}">
     <TextBlock x:Name="Title" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    </Border>
    <Border x:Name="Hover" Background="{DynamicResource Glow}" CornerRadius="8,0,0,8" Opacity="0" />
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Trigger.EnterActions><BeginStoryboard><Storyboard>
      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static local:NoteTheme.Fast}" EasingFunction="{x:Static local:NoteTheme.Ease}" />
     </Storyboard></BeginStoryboard></Trigger.EnterActions>
     <Trigger.ExitActions><BeginStoryboard><Storyboard FillBehavior="Stop">
      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static local:NoteTheme.Fast}" EasingFunction="{x:Static local:NoteTheme.Ease}" />
     </Storyboard></BeginStoryboard></Trigger.ExitActions>
    </Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Title" Property="FontWeight" Value="SemiBold" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
  <Style.Triggers>
   <Trigger Property="IsChecked" Value="True">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
   </Trigger>
  </Style.Triggers>
 </Style>

 <!-- 新建收纳便签：标签列底下一枚单独凸起的小键，只有「+」。和标签靠形状区分：四角都圆，不压到卡片下面。
      键面用顶栏色，不透明（标签区后面是桌面）；凸起、悬停和按下同 KeyButton。尺寸来自标签区资源（NewTabHeight NewTabWidth NewTabMargin NewTabIconSize）。 -->
 <Style x:Key="NewTab" TargetType="Button">
  <Setter Property="Height" Value="{DynamicResource NewTabHeight}" />
  <Setter Property="Width" Value="{DynamicResource NewTabWidth}" />
  <Setter Property="Margin" Value="{DynamicResource NewTabMargin}" />
  <Setter Property="HorizontalAlignment" Value="Left" />
  <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  <Setter Property="Cursor" Value="Hand" />
  <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid Background="Transparent">
    <Border x:Name="Lip" Background="{DynamicResource Shade}" CornerRadius="8" Margin="0,1,0,-1" />
    <Border Background="{DynamicResource HeaderFill}" BorderBrush="{DynamicResource Bevel}" BorderThickness="1" CornerRadius="8" />
    <Border x:Name="Hover" Background="{DynamicResource Glow}" CornerRadius="8" Opacity="0" />
    <Border x:Name="Press" Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Shade}" BorderThickness="0,1,0,0" CornerRadius="8" Opacity="0" />
    <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" />
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Foreground" Value="{DynamicResource Text}" />
     <Trigger.EnterActions><BeginStoryboard><Storyboard>
      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static local:NoteTheme.Fast}" EasingFunction="{x:Static local:NoteTheme.Ease}" />
     </Storyboard></BeginStoryboard></Trigger.EnterActions>
     <Trigger.ExitActions><BeginStoryboard><Storyboard FillBehavior="Stop">
      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static local:NoteTheme.Fast}" EasingFunction="{x:Static local:NoteTheme.Ease}" />
     </Storyboard></BeginStoryboard></Trigger.ExitActions>
    </Trigger>
    <Trigger Property="IsPressed" Value="True">
     <Setter TargetName="Lip" Property="Visibility" Value="Hidden" />
     <Setter TargetName="Press" Property="Opacity" Value="1" />
     <Setter TargetName="Content" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1" /></Setter.Value></Setter>
    </Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- 标签的悬停预览：标题、开头几行和修改时间。 -->
 <Style x:Key="TabPreviewTitle" TargetType="TextBlock">
  <Setter Property="FontWeight" Value="SemiBold" />
  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
 </Style>

 <Style x:Key="TabPreviewLine" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  <Setter Property="Margin" Value="0,3,0,0" />
 </Style>

 <Style x:Key="TabPreviewNote" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  <Setter Property="FontSize" Value="11" />
  <Setter Property="Opacity" Value="0.8" />
  <Setter Property="Margin" Value="0,8,0,0" />
 </Style>

 <!-- 便签上弹出的小卡片（链接卡片、文字颜色）：外边距留给阴影，阴影单独一层。 -->
 <Style x:Key="PopupCard" TargetType="ContentControl">
  <Setter Property="Background" Value="{DynamicResource Surface}" />
  <Setter Property="Foreground" Value="{DynamicResource Text}" />
  <Setter Property="BorderBrush" Value="{DynamicResource Edge}" />
  <Setter Property="Padding" Value="6" />
  <Setter Property="Focusable" Value="False" />
  <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
  <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <Grid Margin="6,4,6,8">
    <Border Background="{TemplateBinding Background}" CornerRadius="8">
     <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.16" /></Border.Effect>
    </Border>
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter />
    </Border>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <Style x:Key="LinkCardAddress" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  <Setter Property="FontSize" Value="12" />
  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
 </Style>

 <!-- 卡片上的按钮不抢焦点，光标留在正文里。 -->
 <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
  <Setter Property="Height" Value="26" />
  <Setter Property="FontSize" Value="12" />
  <Setter Property="Padding" Value="6,0" />
  <Setter Property="Focusable" Value="False" />
 </Style>

 <!-- 便签窗口：卡片阴影画在背后单独一层（贴边的短阴影 + 外圈的柔和阴影），外层缓存成位图，打字时不重算。 -->
 <Style x:Key="CardShadow" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource Surface}" />
  <Setter Property="CornerRadius" Value="10" />
  <Setter Property="IsHitTestVisible" Value="False" />
  <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.15" /></Setter.Value></Setter>
 </Style>

 <Style x:Key="CardContact" TargetType="Border" BasedOn="{StaticResource CardShadow}">
  <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.18" /></Setter.Value></Setter>
 </Style>

 <!-- 分隔线：刻进去的一道细缝（左暗右亮）。 -->
 <Style x:Key="ToolSeparator" TargetType="Border">
  <Setter Property="Width" Value="2" />
  <Setter Property="Height" Value="16" />
  <Setter Property="Margin" Value="4,0" />
  <Setter Property="VerticalAlignment" Value="Center" />
  <Setter Property="Background" Value="{DynamicResource Etch}" />
 </Style>

 <!-- 文字颜色色块：当前颜色外圈实线，悬停淡圈。 -->
 <Style x:Key="Swatch" TargetType="ToggleButton">
  <Setter Property="Width" Value="28" />
  <Setter Property="Height" Value="28" />
  <Setter Property="Cursor" Value="Hand" />
  <Setter Property="Focusable" Value="False" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
   <Grid Background="Transparent">
    <Ellipse x:Name="Ring" Margin="1" Stroke="{DynamicResource Text}" StrokeThickness="1.5" Opacity="0" />
    <Ellipse Margin="5" Fill="{TemplateBinding Background}" />
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="0.35" /></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- 右下角缩放角：两道淡色斜线，深浅色都不抢眼。 -->
 <Style TargetType="ResizeGrip">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ResizeGrip">
   <Grid Background="Transparent">
    <Path Data="M 10,2 L 2,10 M 10,6 L 6,10" Stroke="{DynamicResource Muted}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
     Opacity="0.55" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" />
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- 细滚动条：没有箭头，滑块平时细而淡，悬停时加宽加深。 -->
 <Style x:Key="ScrollPage" TargetType="RepeatButton">
  <Setter Property="Focusable" Value="False" />
  <Setter Property="IsTabStop" Value="False" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
 </Style>

 <Style x:Key="ScrollThumb" TargetType="Thumb">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
   <Border x:Name="Bar" Background="{DynamicResource Muted}" CornerRadius="3" Opacity="0.35" />
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Opacity" Value="0.6" /></Trigger>
    <Trigger Property="IsDragging" Value="True"><Setter TargetName="Bar" Property="Opacity" Value="0.75" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <Style TargetType="ScrollBar">
  <Setter Property="Width" Value="10" />
  <Setter Property="MinWidth" Value="10" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
   <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="3,2">
    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" /></Track.DecreaseRepeatButton>
    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" /></Track.IncreaseRepeatButton>
    <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
   </Track>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PART_Track" Property="Margin" Value="2" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
  <Style.Triggers>
   <Trigger Property="Orientation" Value="Horizontal">
    <Setter Property="Width" Value="Auto" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Height" Value="10" />
    <Setter Property="MinHeight" Value="10" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
     <Track x:Name="PART_Track" Margin="2,3">
      <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" /></Track.DecreaseRepeatButton>
      <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" /></Track.IncreaseRepeatButton>
      <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
     </Track>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PART_Track" Property="Margin" Value="2" /></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Trigger>
  </Style.Triggers>
 </Style>

 <!-- 弹窗外壳（提示、确认、链接、设置，见 Dialogs/NoteDialog）：和便签同一套配色与按键。四周 12 的阴影边距，圆角 8；
      顶栏和便签顶栏一样上浅下深，左边标题，右边键托里放关闭，整条可以拖动。 -->
 <Style x:Key="DialogWindow" TargetType="Window">
  <Setter Property="WindowStyle" Value="None" />
  <Setter Property="AllowsTransparency" Value="True" />
  <Setter Property="Background" Value="Transparent" />
  <Setter Property="ResizeMode" Value="NoResize" />
  <Setter Property="SizeToContent" Value="Height" />
  <Setter Property="ShowInTaskbar" Value="False" />
  <Setter Property="UseLayoutRounding" Value="True" />
  <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
  <Setter Property="FontSize" Value="13" />
  <Setter Property="Foreground" Value="{DynamicResource Text}" />
  <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  <Setter Property="shell:WindowChrome.WindowChrome">
   <Setter.Value><shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" /></Setter.Value>
  </Setter>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Window">
   <Grid x:Name="Card" Margin="12">
    <Grid CacheMode="BitmapCache" IsHitTestVisible="False">
     <Border Style="{StaticResource CardShadow}" CornerRadius="8" />
     <Border Style="{StaticResource CardContact}" CornerRadius="8" />
    </Grid>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="8" RenderOptions.ClearTypeHint="Enabled">
     <DockPanel>
      <Border DockPanel.Dock="Top" Height="42" Background="{DynamicResource HeaderFill}" BorderBrush="{DynamicResource Bevel}" BorderThickness="0,1,0,1" CornerRadius="7,7,0,0">
       <DockPanel Margin="14,0,6,0">
        <ContentControl DockPanel.Dock="Right" Style="{StaticResource KeyTray}">
         <Button Style="{StaticResource DangerIconButton}" Command="{x:Static SystemCommands.CloseWindowCommand}" ToolTip="关闭（Esc）" AutomationProperties.Name="关闭">
          <ui:SymbolIcon Symbol="Dismiss20" />
         </Button>
        </ContentControl>
        <TextBlock Text="{TemplateBinding Title}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
       </DockPanel>
      </Border>
      <Grid>
       <Border Height="6" VerticalAlignment="Top" Background="{DynamicResource HeaderShade}" IsHitTestVisible="False" />
       <AdornerDecorator><ContentPresenter /></AdornerDecorator>
      </Grid>
     </DockPanel>
    </Border>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- 弹窗文字：说明和状态 11 号淡色；行尾显示的当前值 12 号淡色。 -->
 <Style x:Key="DialogHint" TargetType="TextBlock">
  <Setter Property="FontSize" Value="11" />
  <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  <Setter Property="TextWrapping" Value="Wrap" />
 </Style>

 <Style x:Key="DialogValue" TargetType="TextBlock">
  <Setter Property="FontSize" Value="12" />
  <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  <Setter Property="VerticalAlignment" Value="Center" />
 </Style>

 <!-- 设置的分页：键托里一排带字的开关，选中的一页凹进去。 -->
 <Style x:Key="DialogTab" TargetType="RadioButton" BasedOn="{StaticResource LabelToggle}">
  <Setter Property="Padding" Value="14,0" />
 </Style>

 <!-- 输入框：凹进去的一道槽（上沿暗、下沿亮），获得焦点时描一圈淡色。Tag 写占位提示，没有文字时显示。 -->
 <Style x:Key="Field" TargetType="TextBox">
  <Setter Property="Foreground" Value="{DynamicResource Text}" />
  <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
  <Setter Property="SelectionBrush" Value="{DynamicResource Muted}" />
  <Setter Property="MinHeight" Value="30" />
  <Setter Property="Padding" Value="8,5" />
  <Setter Property="VerticalContentAlignment" Value="Center" />
  <Setter Property="FocusVisualStyle" Value="{x:Null}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
   <Grid>
    <Border Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Groove}" BorderThickness="1" CornerRadius="6" />
    <Border x:Name="Ring" BorderBrush="{DynamicResource Muted}" BorderThickness="1.5" CornerRadius="6" Opacity="0" />
    <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Muted}" Opacity="0.8" Margin="{TemplateBinding Padding}" Padding="2,0"
     VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Visibility="Collapsed" />
    <!-- 内边距由 TextBox 自己加在文字外面，这里不再加。 -->
    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"
     HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible" /></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1" /></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- 开关：凹槽里一颗凸起的钮；开启时槽填成墨色，钮滑到右边。 -->
 <Style x:Key="Switch" TargetType="ToggleButton">
  <Setter Property="Width" Value="38" />
  <Setter Property="Height" Value="22" />
  <Setter Property="VerticalAlignment" Value="Center" />
  <Setter Property="Cursor" Value="Hand" />
  <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
   <Grid Background="Transparent">
    <Border Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Groove}" BorderThickness="1" CornerRadius="11" />
    <Border x:Name="On" Background="{DynamicResource Text}" CornerRadius="11" Opacity="0" />
    <Grid x:Name="Knob" Width="16" Height="16" Margin="3,0" HorizontalAlignment="Left">
     <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
     <Ellipse Fill="{DynamicResource Shade}" Margin="0,1,0,-1" />
     <Ellipse Fill="{DynamicResource Surface}" Stroke="{DynamicResource Bevel}" StrokeThickness="1" />
    </Grid>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True">
     <Trigger.EnterActions><BeginStoryboard><Storyboard>
      <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="16" Duration="{x:Static local:NoteTheme.Fast}" EasingFunction="{x:Static local:NoteTheme.Ease}" />
      <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static local:NoteTheme.Fast}" EasingFunction="{x:Static local:NoteTheme.Ease}" />
     </Storyboard></BeginStoryboard></Trigger.EnterActions>
     <Trigger.ExitActions><BeginStoryboard><Storyboard>
      <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="{x:Static local:NoteTheme.Fast}" EasingFunction="{x:Static local:NoteTheme.Ease}" />
      <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static local:NoteTheme.Fast}" EasingFunction="{x:Static local:NoteTheme.Ease}" />
     </Storyboard></BeginStoryboard></Trigger.ExitActions>
    </Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- 滑块：细槽，左边已选的一段填墨色；钮和开关的钮一样。 -->
 <Style x:Key="SliderFill" TargetType="RepeatButton" BasedOn="{StaticResource ScrollPage}">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
   <Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="{DynamicResource Text}" Opacity="0.7" VerticalAlignment="Center" /></Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <Style x:Key="SliderKnob" TargetType="Thumb">
  <Setter Property="Width" Value="16" />
  <Setter Property="Height" Value="16" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
   <Grid>
    <Ellipse Fill="{DynamicResource Shade}" Margin="0,1,0,-1" />
    <Ellipse Fill="{DynamicResource Surface}" Stroke="{DynamicResource Bevel}" StrokeThickness="1" />
    <Ellipse x:Name="Hover" Fill="{DynamicResource Glow}" Opacity="0" />
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1" /></Trigger>
    <Trigger Property="IsDragging" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <Style x:Key="DialogSlider" TargetType="Slider">
  <Setter Property="Height" Value="22" />
  <Setter Property="Cursor" Value="Hand" />
  <Setter Property="IsMoveToPointEnabled" Value="True" />
  <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
   <Grid Background="Transparent">
    <Border Height="6" CornerRadius="3" Margin="1,0" Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Groove}" BorderThickness="1" VerticalAlignment="Center" />
    <Track x:Name="PART_Track">
     <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge" /></Track.DecreaseRepeatButton>
     <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="Slider.IncreaseLarge" /></Track.IncreaseRepeatButton>
     <Track.Thumb><Thumb Style="{StaticResource SliderKnob}" /></Track.Thumb>
    </Track>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- 勾选框：小凹槽，勾上时填墨色并显示对勾。 -->
 <Style x:Key="DialogCheck" TargetType="CheckBox">
  <Setter Property="Foreground" Value="{DynamicResource Text}" />
  <Setter Property="Cursor" Value="Hand" />
  <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
   <StackPanel Orientation="Horizontal" Background="Transparent">
    <Grid Width="18" Height="18" VerticalAlignment="Center">
     <Border Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Groove}" BorderThickness="1" CornerRadius="4" />
     <Border x:Name="On" Background="{DynamicResource Text}" CornerRadius="4" Visibility="Collapsed">
      <ui:SymbolIcon Symbol="Checkmark20" FontSize="14" Foreground="{DynamicResource Surface}" HorizontalAlignment="Center" VerticalAlignment="Center" />
     </Border>
    </Grid>
    <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
   </StackPanel>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="On" Property="Visibility" Value="Visible" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- 配色色块（设置）：和文字颜色色块同一种做法，色块加一圈淡边，浅色也看得出轮廓。 -->
 <Style x:Key="PaletteSwatch" TargetType="RadioButton">
  <Setter Property="Width" Value="32" />
  <Setter Property="Height" Value="32" />
  <Setter Property="Cursor" Value="Hand" />
  <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
   <Grid Background="Transparent">
    <Ellipse x:Name="Ring" Margin="1" Stroke="{DynamicResource Text}" StrokeThickness="1.5" Opacity="0" />
    <Ellipse Margin="5" Fill="{TemplateBinding Background}" Stroke="{DynamicResource Edge}" StrokeThickness="1" />
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="0.35" /></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- 菜单和提示：底色跟随便签，圆角 8 / 6，阴影单独一层，不让文字走特效渲染。 -->
 <Style TargetType="ContextMenu">
  <Setter Property="Background" Value="{DynamicResource Surface}" />
  <Setter Property="Foreground" Value="{DynamicResource Text}" />
  <Setter Property="BorderBrush" Value="{DynamicResource Edge}" />
  <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
  <Setter Property="FontSize" Value="12" />
  <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  <Setter Property="MinWidth" Value="168" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
   <Grid Margin="6">
    <Border Background="{TemplateBinding Background}" CornerRadius="8">
     <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.16" /></Border.Effect>
    </Border>
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
     <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
    </Border>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- 有下级的菜单项（托盘的「便签（N）」）：右边一个箭头，下级菜单向右展开，样式和菜单相同，太长时滚动。 -->
 <ControlTemplate x:Key="SubmenuHeader" TargetType="MenuItem">
  <Grid x:Name="Row" Height="30" Background="Transparent" SnapsToDevicePixels="True">
   <Border x:Name="Highlight" Background="{DynamicResource Subtle}" CornerRadius="5" Opacity="0" />
   <Grid Margin="{TemplateBinding Padding}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <ContentPresenter ContentSource="Icon" HorizontalAlignment="Left" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Muted}" />
    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
    <ui:SymbolIcon Grid.Column="2" Style="{StaticResource Icon}" Symbol="ChevronRight20" FontSize="12" Margin="24,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
   </Grid>
   <Popup IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" HorizontalOffset="-2" VerticalOffset="-10"
    AllowsTransparency="True" Focusable="False" PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}">
    <Grid Margin="6">
     <Border Background="{DynamicResource Surface}" CornerRadius="8">
      <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.16" /></Border.Effect>
     </Border>
     <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="8" Padding="4">
      <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
      </ScrollViewer>
     </Border>
    </Grid>
   </Popup>
  </Grid>
  <ControlTemplate.Triggers>
   <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Highlight" Property="Opacity" Value="1" /></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.4" /></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>

 <!-- 菜单项：左列图标（可勾选的项在这里显示对勾），右侧快捷键。 -->
 <Style TargetType="MenuItem">
  <Setter Property="Foreground" Value="{DynamicResource Text}" />
  <Setter Property="Padding" Value="8,0,12,0" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
   <Grid x:Name="Row" Height="30" Background="Transparent" SnapsToDevicePixels="True">
    <Border x:Name="Highlight" Background="{DynamicResource Subtle}" CornerRadius="5" Opacity="0" />
    <Grid Margin="{TemplateBinding Padding}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <ContentPresenter x:Name="IconHost" ContentSource="Icon" HorizontalAlignment="Left" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Muted}" />
     <ui:SymbolIcon x:Name="Check" Style="{StaticResource Icon}" Symbol="Checkmark20" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
     <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
     <TextBlock x:Name="Gesture" Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource Muted}" FontSize="11" />
    </Grid>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Highlight" Property="Opacity" Value="1" /></Trigger>
    <Trigger Property="IsChecked" Value="True">
     <Setter TargetName="Check" Property="Visibility" Value="Visible" />
     <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
    </Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.4" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
  <Style.Triggers>
   <Trigger Property="Role" Value="SubmenuHeader"><Setter Property="Template" Value="{StaticResource SubmenuHeader}" /></Trigger>
  </Style.Triggers>
 </Style>

 <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
   <Border Height="1" Margin="8,4" Background="{DynamicResource Edge}" />
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <Style TargetType="ToolTip">
  <Setter Property="Background" Value="{DynamicResource Surface}" />
  <Setter Property="Foreground" Value="{DynamicResource Text}" />
  <Setter Property="BorderBrush" Value="{DynamicResource Edge}" />
  <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
  <Setter Property="FontSize" Value="12" />
  <Setter Property="Padding" Value="8,5" />
  <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  <Setter Property="MaxWidth" Value="372" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
   <Grid Margin="6">
    <Border Background="{TemplateBinding Background}" CornerRadius="6">
     <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.14" /></Border.Effect>
    </Border>
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <ContentPresenter>
      <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style></ContentPresenter.Resources>
     </ContentPresenter>
    </Border>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
