<local:NoteDialog x:Class="Zhuobianji.LinkWindow" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Zhuobianji"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="链接" Width="440" WindowStartupLocation="CenterOwner">
 <StackPanel Margin="16,14,16,16">
  <TextBlock Text="名称" Margin="0,0,0,6" />
  <TextBox x:Name="NameBox" Tag="留空时用文件名、文件夹名，或网址的域名和路径" Margin="0,0,0,14" />
  <TextBlock Text="地址" Margin="0,0,0,6" />
  <!-- 选文件、选文件夹放在地址框右边的键托里。 -->
  <DockPanel>
   <ContentControl DockPanel.Dock="Right" Style="{StaticResource KeyTray}" VerticalAlignment="Top" Margin="8,0,0,0">
    <StackPanel Orientation="Horizontal">
     <Button Style="{StaticResource IconButton}" ToolTip="选择文件" AutomationProperties.Name="选择文件" Click="OnChooseFile">
      <ui:SymbolIcon Symbol="Document20" />
     </Button>
     <Button Style="{StaticResource IconButton}" Margin="2,0,0,0" ToolTip="选择文件夹" AutomationProperties.Name="选择文件夹" Click="OnChooseFolder">
      <ui:SymbolIcon Symbol="Folder20" />
     </Button>
    </StackPanel>
   </ContentControl>
   <TextBox x:Name="AddressBox" TextWrapping="Wrap" Tag="网址，或文件、文件夹的完整路径" />
  </DockPanel>
  <TextBlock x:Name="Status" Style="{StaticResource DialogHint}" Foreground="{DynamicResource Error}" Margin="0,8,0,0" Visibility="Collapsed" />
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
   <Button Style="{StaticResource KeyButton}" Content="取消" Margin="0,0,8,0" Click="OnCancel" />
   <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="确定" IsDefault="True" Click="OnSave" />
  </StackPanel>
 </StackPanel>
</local:NoteDialog>
